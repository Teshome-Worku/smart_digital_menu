# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.emltgixlsieopypdgczc:0CLd3PRlYOCrA2BZ@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# API Server
API_PORT=4000
API_URL=http://localhost:4000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Public URL encoded in table QR codes. For phone testing, use the computer's
# LAN IP (for example http://192.168.1.20:3000), not localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chapa hosted checkout — TEST credentials only. Never expose this key to the web app.
CHAPA_TEST_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
# Public API callback (normally your HTTPS tunnel/domain + /api/v1/payments/chapa/callback).
CHAPA_CALLBACK_URL=

# JWT Secrets (generate strong random strings for production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (connect when ready)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Node
NODE_ENV=development
